#property copyright "Liquidity Hunter EA"
#property version   "4.00"
#property strict

#include <Trade/Trade.mqh>

//+------------------------------------------------------------------+
//| ورودی‌ها                                                         |
//+------------------------------------------------------------------+
input int      InpMagicNumber    = 20260829;      
input double   InpRiskPercent    = 2.0;           
input int      InpATRPeriod      = 14;            
input int      InpPivotBars      = 5;             
input double   InpRiskReward     = 3.0;           
input int      InpHTF_Timeframe  = 60;            // 60=1ساعته | 240=4ساعته
input int      InpEMA_Period     = 50;            
input bool     InpUseTrailing    = true;          
input double   InpTrailingATR    = 0.3;           
input int      InpMaxSpread      = 150;           
input bool     InpDebugMode      = true;          

//+------------------------------------------------------------------+
//| متغیرهای سراسری                                                  |
//+------------------------------------------------------------------+
CTrade         m_trade;
ulong          m_magic = InpMagicNumber;
int            m_atrHandle = INVALID_HANDLE;
int            m_emaHandle = INVALID_HANDLE;
string         m_symbol;
ENUM_TIMEFRAMES m_timeframe;

double         m_lastSwingHigh = 0;
double         m_lastSwingLow  = 0;
int            m_lastSwingBar  = 0;

double         m_entryLevel   = 0;
double         m_slLevel      = 0;
double         m_tp1Level     = 0;
double         m_tp2Level     = 0;
double         m_tp3Level     = 0;
int            m_signalType   = 0;
datetime       m_lastSignalTime = 0;

// *** متغیر جدید برای تشخیص کندل جدید در بک‌تست و ریل‌تایم ***
datetime       m_lastBarTime = 0;

//+------------------------------------------------------------------+
//| تابع شروع                                                        |
//+------------------------------------------------------------------+
int OnInit()
{
   m_symbol    = Symbol();
   m_timeframe = Period();
   m_trade.SetExpertMagicNumber(m_magic);
   
   Print("🔧 راه‌اندازی ربات روی: ", m_symbol, " | تایم: ", EnumToString(m_timeframe));
   
   // ایجاد ATR
   m_atrHandle = iATR(m_symbol, m_timeframe, InpATRPeriod);
   if(m_atrHandle == INVALID_HANDLE)
   {
      Print("❌ خطا در ATR! کد: ", GetLastError());
      return INIT_FAILED;
   }
   
   // ایجاد EMA (تایم بالاتر)
   ENUM_TIMEFRAMES htf = (ENUM_TIMEFRAMES)InpHTF_Timeframe;
   m_emaHandle = iMA(m_symbol, htf, InpEMA_Period, 0, MODE_EMA, PRICE_CLOSE);
   if(m_emaHandle == INVALID_HANDLE)
   {
      Print("❌ خطا در EMA! کد: ", GetLastError());
      return INIT_FAILED;
   }
   
   // مقداردهی اولیه سوئینگ‌ها
   FindLastSwingPoints();
   
   // مقداردهی اولیه زمان آخرین کندل
   m_lastBarTime = iTime(m_symbol, m_timeframe, 0);
   
   Print("✅ ربات راه‌اندازی شد!");
   Print("📊 آخرین قله: ", m_lastSwingHigh, " | دره: ", m_lastSwingLow);
   return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
//| تابع پایان کار                                                   |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   if(m_atrHandle != INVALID_HANDLE) IndicatorRelease(m_atrHandle);
   if(m_emaHandle != INVALID_HANDLE) IndicatorRelease(m_emaHandle);
   Print("🛑 ربات متوقف شد.");
}

//+------------------------------------------------------------------+
//| تابع اصلی (حلقه هر تیک)                                          |
//+------------------------------------------------------------------+
void OnTick()
{
   // مدیریت پوزیشن‌های باز
   if(PositionExists())
   {
      ManageOpenPositions();
      return;
   }
   
   // بررسی اسپرد
   if(!CheckSpread()) return;
   
   // دریافت داده‌ها
   double atr = GetATR();
   if(atr <= 0) return;
   
   double htfEMA = GetHTF_EMA();
   if(htfEMA <= 0) return;
   
   double currentClose = iClose(m_symbol, m_timeframe, 1);
   double currentHigh = iHigh(m_symbol, m_timeframe, 1);
   double currentLow  = iLow(m_symbol, m_timeframe, 1);
   
   bool isUptrend = (currentClose > htfEMA);
   
   // *** اصلاح مهم: تشخیص کندل جدید با iTime (هم برای بک‌تست و هم ریل‌تایم) ***
   datetime currentBarTime = iTime(m_symbol, m_timeframe, 0);
   if(currentBarTime != m_lastBarTime)
   {
      // یک کندل جدید بسته شده است
      m_lastBarTime = currentBarTime;
      
      // به‌روزرسانی نقاط سوئینگ
      UpdateSwingPoints();
      
      if(InpDebugMode)
         Print("🔄 [", TimeToString(currentBarTime), "] سوئینگ‌ها: قله=", 
               DoubleToString(m_lastSwingHigh, _Digits), " دره=", DoubleToString(m_lastSwingLow, _Digits));
   }
   else
   {
      // اگر کندل جدیدی نبسته شده، کاری نکن (برای کاهش بار پردازشی)
      return;
   }
   
   // تشخیص شکست سوئینگ (با استفاده از کندل شماره 1 که همین الان بسته شده)
   bool isBreakBuy  = (currentHigh > m_lastSwingHigh && iHigh(m_symbol, m_timeframe, 2) <= m_lastSwingHigh);
   bool isBreakSell = (currentLow  < m_lastSwingLow  && iLow(m_symbol, m_timeframe, 2)  >= m_lastSwingLow);
   
   if(isBreakBuy || isBreakSell)
   {
      int barIndex = 1; // کندل شکننده
      double barOpen  = iOpen(m_symbol, m_timeframe, barIndex);
      double barClose = iClose(m_symbol, m_timeframe, barIndex);
      double barHigh  = iHigh(m_symbol, m_timeframe, barIndex);
      double barLow   = iLow(m_symbol, m_timeframe, barIndex);
      
      double entry = (barOpen + barClose) / 2.0;
      
      // بررسی همسویی با روند
      if(isBreakBuy && isUptrend)
      {
         m_entryLevel = entry;
         m_slLevel    = barLow - (SymbolInfoDouble(m_symbol, SYMBOL_POINT) * 10);
         m_signalType = 1;
      }
      else if(isBreakSell && !isUptrend)
      {
         m_entryLevel = entry;
         m_slLevel    = barHigh + (SymbolInfoDouble(m_symbol, SYMBOL_POINT) * 10);
         m_signalType = -1;
      }
      else
      {
         if(InpDebugMode) Print("⛔ جهت همخوانی ندارد.");
         return;
      }
      
      // جلوگیری از سیگنال‌های تکراری
      if(TimeCurrent() - m_lastSignalTime < 60) return;
      m_lastSignalTime = TimeCurrent();
      
      double slDist = MathAbs(m_entryLevel - m_slLevel);
      if(slDist < SymbolInfoDouble(m_symbol, SYMBOL_POINT) * 10) return;
      
      double dailyOpen = GetDailyOpen();
      m_tp1Level = m_entryLevel + (0.5 * atr) * (m_signalType == 1 ? 1 : -1);
      m_tp2Level = dailyOpen;
      m_tp3Level = m_entryLevel + (slDist * InpRiskReward) * (m_signalType == 1 ? 1 : -1);
      
      Print("========================================");
      Print("📢 **سیگنال جدید شناسایی شد!**");
      Print("   نوع: ", (m_signalType == 1) ? "خرید" : "فروش");
      Print("   ورود (لیمیت): ", DoubleToString(m_entryLevel, _Digits));
      Print("   حد ضرر: ", DoubleToString(m_slLevel, _Digits));
      Print("   هدف 1: ", DoubleToString(m_tp1Level, _Digits));
      Print("   هدف 3: ", DoubleToString(m_tp3Level, _Digits));
      Print("========================================");
      
      PlaceLimitOrder();
   }
}

//+------------------------------------------------------------------+
//| پیدا کردن نقاط سوئینگ                                            |
//+------------------------------------------------------------------+
void FindLastSwingPoints()
{
   int bars = iBars(m_symbol, m_timeframe);
   if(bars < 20) return;
   
   for(int i = 10; i < bars && i < 300; i++)
   {
      bool isHigh = true, isLow = true;
      double h = iHigh(m_symbol, m_timeframe, i);
      double l = iLow(m_symbol, m_timeframe, i);
      
      for(int j = 1; j <= InpPivotBars; j++)
      {
         if(iHigh(m_symbol, m_timeframe, i-j) >= h || iHigh(m_symbol, m_timeframe, i+j) >= h) isHigh = false;
         if(iLow(m_symbol, m_timeframe, i-j)  <= l || iLow(m_symbol, m_timeframe, i+j)  <= l) isLow  = false;
      }
      
      if(isHigh && h > 0) { m_lastSwingHigh = h; m_lastSwingBar = i; }
      if(isLow  && l > 0) { m_lastSwingLow  = l; }
   }
   
   if(m_lastSwingHigh == 0 || m_lastSwingLow == 0)
   {
      m_lastSwingHigh = iHigh(m_symbol, m_timeframe, iHighest(m_symbol, m_timeframe, MODE_HIGH, 30, 1));
      m_lastSwingLow  = iLow(m_symbol, m_timeframe, iLowest(m_symbol, m_timeframe, MODE_LOW, 30, 1));
   }
}

//+------------------------------------------------------------------+
//| به‌روزرسانی سوئینگ‌ها                                             |
//+------------------------------------------------------------------+
void UpdateSwingPoints()
{
   int bars = iBars(m_symbol, m_timeframe);
   int start = MathMax(1, m_lastSwingBar - 5);
   
   for(int i = start; i < bars - InpPivotBars; i++)
   {
      bool isHigh = true, isLow = true;
      double h = iHigh(m_symbol, m_timeframe, i);
      double l = iLow(m_symbol, m_timeframe, i);
      
      for(int j = 1; j <= InpPivotBars; j++)
      {
         if(iHigh(m_symbol, m_timeframe, i-j) >= h || iHigh(m_symbol, m_timeframe, i+j) >= h) isHigh = false;
         if(iLow(m_symbol, m_timeframe, i-j)  <= l || iLow(m_symbol, m_timeframe, i+j)  <= l) isLow  = false;
      }
      
      if(isHigh && h > m_lastSwingHigh + SymbolInfoDouble(m_symbol, SYMBOL_POINT)*10)
      {
         m_lastSwingHigh = h;
         m_lastSwingBar = i;
      }
      if(isLow && l < m_lastSwingLow - SymbolInfoDouble(m_symbol, SYMBOL_POINT)*10)
      {
         m_lastSwingLow = l;
      }
   }
}

//+------------------------------------------------------------------+
//| توابع دریافت داده                                                |
//+------------------------------------------------------------------+
double GetATR()
{
   double arr[];
   ArraySetAsSeries(arr, true);
   if(CopyBuffer(m_atrHandle, 0, 0, 1, arr) <= 0) return 0;
   return arr[0];
}

double GetHTF_EMA()
{
   double arr[];
   ArraySetAsSeries(arr, true);
   if(CopyBuffer(m_emaHandle, 0, 0, 1, arr) <= 0) return 0;
   return arr[0];
}

double GetDailyOpen()
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(m_symbol, PERIOD_D1, 0, 1, rates) <= 0) return 0;
   return rates[0].open;
}

bool CheckSpread()
{
   double spread = (SymbolInfoDouble(m_symbol, SYMBOL_ASK) - SymbolInfoDouble(m_symbol, SYMBOL_BID)) / SymbolInfoDouble(m_symbol, SYMBOL_POINT);
   if(spread > InpMaxSpread)
   {
      if(InpDebugMode && MathRand()%10 == 0) Print("⚠️ اسپرد بالا: ", DoubleToString(spread, 0));
      return false;
   }
   return true;
}

bool PositionExists()
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong t = PositionGetTicket(i);
      if(PositionSelectByTicket(t))
      {
         if(PositionGetString(POSITION_SYMBOL) == m_symbol && PositionGetInteger(POSITION_MAGIC) == m_magic)
            return true;
      }
   }
   return false;
}

void PlaceLimitOrder()
{
   double riskAmount = AccountInfoDouble(ACCOUNT_BALANCE) * (InpRiskPercent / 100.0);
   double slDist = MathAbs(m_entryLevel - m_slLevel);
   double tickVal = SymbolInfoDouble(m_symbol, SYMBOL_TRADE_TICK_VALUE);
   double tickSize = SymbolInfoDouble(m_symbol, SYMBOL_TRADE_TICK_SIZE);
   double lotStep = SymbolInfoDouble(m_symbol, SYMBOL_VOLUME_STEP);
   double lotMin = SymbolInfoDouble(m_symbol, SYMBOL_VOLUME_MIN);
   double lotMax = SymbolInfoDouble(m_symbol, SYMBOL_VOLUME_MAX);
   
   double lot = riskAmount / (slDist / tickSize * tickVal);
   lot = MathFloor(lot / lotStep) * lotStep;
   lot = MathMax(lotMin, MathMin(lotMax, lot));
   
   if(lot <= 0) { Print("❌ حجم نامعتبر!"); return; }
   
   m_trade.SetDeviationInPoints(20);
   bool result = false;
   
   if(m_signalType == 1)
      result = m_trade.BuyLimit(lot, m_entryLevel, m_symbol, m_slLevel, m_tp1Level, ORDER_TIME_GTC, 0, "LH BUY");
   else if(m_signalType == -1)
      result = m_trade.SellLimit(lot, m_entryLevel, m_symbol, m_slLevel, m_tp1Level, ORDER_TIME_GTC, 0, "LH SELL");
   
   if(result)
      Print("✅ سفارش ثبت شد! تیکت: ", m_trade.ResultOrder());
   else
      Print("❌ خطا در ثبت سفارش! کد: ", GetLastError());
}

void ManageOpenPositions()
{
   if(!InpUseTrailing) return;
   double atr = GetATR();
   if(atr <= 0) return;
   
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong t = PositionGetTicket(i);
      if(!PositionSelectByTicket(t)) continue;
      if(PositionGetString(POSITION_SYMBOL) != m_symbol || PositionGetInteger(POSITION_MAGIC) != m_magic) continue;
      
      double currentSL = PositionGetDouble(POSITION_SL);
      double openPrice = PositionGetDouble(POSITION_PRICE_OPEN);
      double profit = PositionGetDouble(POSITION_PROFIT);
      
      if(profit > 0 && currentSL != openPrice)
      {
         if(m_trade.PositionModify(t, openPrice, PositionGetDouble(POSITION_TP)))
            Print("🔒 بریک‌ایون!");
      }
      
      double bid = SymbolInfoDouble(m_symbol, SYMBOL_BID);
      double ask = SymbolInfoDouble(m_symbol, SYMBOL_ASK);
      double trailDist = atr * InpTrailingATR;
      double newSL = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY) ? bid - trailDist : ask + trailDist;
      
      if(MathAbs(newSL - currentSL) > SymbolInfoDouble(m_symbol, SYMBOL_POINT)*10)
      {
         if((PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY && newSL > currentSL) ||
            (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_SELL && newSL < currentSL))
         {
            if(m_trade.PositionModify(t, newSL, PositionGetDouble(POSITION_TP)))
               Print("📈 تریلینگ: ", DoubleToString(newSL, _Digits));
         }
      }
   }
}
