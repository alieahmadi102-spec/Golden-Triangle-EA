#property copyright "Simple Golden Triangle"
#property version   "2.00"
#property strict

//--- Input Parameters
input group "=== Risk Management ==="
input double RiskPercent = 1.0;
input double MinRiskReward = 2.0;
input int    MaxTradesPerDay = 5;

input group "=== Strategy Settings ==="
input int    SwingLength = 3;
input double FVGThreshold = 0.3;
input bool   TradeAllSessions = true;

input group "=== Money Management ==="
input double StopLossPoints = 100;
input double TakeProfitPoints = 300;
input bool   UseBreakEven = true;
input double BreakEvenTrigger = 100;
input double BreakEvenProfit = 20;

//--- Global Variables
datetime lastTradeDate = 0;
int tradesToday = 0;
double lastPivotHigh = 0;
double lastPivotLow = 0;
bool sweepDetected = false;
string sweepType = "";

//+------------------------------------------------------------------+
int OnInit()
{
   Print("=== Simple Golden Triangle EA Started ===");
   Print("Symbol: ", _Symbol, " Period: ", _Period);
   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   Print("EA Stopped");
}

//+------------------------------------------------------------------+
void OnTick()
{
   static datetime lastBarTime = 0;
   datetime currentBarTime = iTime(_Symbol, PERIOD_CURRENT, 0);
   
   if(currentBarTime == lastBarTime) return;
   lastBarTime = currentBarTime;
   
   // Reset daily counter
   if(iTime(_Symbol, PERIOD_D1, 0) != lastTradeDate)
   {
      tradesToday = 0;
      lastTradeDate = iTime(_Symbol, PERIOD_D1, 0);
      Print("New day started. Trades reset to 0");
   }
   
   if(tradesToday >= MaxTradesPerDay)
   {
      Print("Max trades reached for today: ", tradesToday);
      return;
   }
   
   if(PositionsTotal() > 0)
   {
      ManagePositions();
      return;
   }
   
   // Detect pivots every bar
   DetectPivots();
   
   if(sweepDetected)
   {
      Print("Sweep detected: ", sweepType);
      CheckEntrySetup();
   }
}

//+------------------------------------------------------------------+
void DetectPivots()
{
   int pivotBar = SwingLength;
   int totalBars = iBars(_Symbol, PERIOD_CURRENT);
   
   if(pivotBar >= totalBars - 2) return;
   
   // Detect Pivot High
   bool isPH = true;
   double phValue = iHigh(_Symbol, PERIOD_CURRENT, pivotBar);
   
   for(int i = 1; i <= SwingLength; i++)
   {
      if(iHigh(_Symbol, PERIOD_CURRENT, pivotBar - i) >= phValue ||
         iHigh(_Symbol, PERIOD_CURRENT, pivotBar + i) >= phValue)
      {
         isPH = false;
         break;
      }
   }
   
   if(isPH && phValue != lastPivotHigh)
   {
      lastPivotHigh = phValue;
      Print("New Pivot High detected at: ", lastPivotHigh);
   }
   
   // Detect Pivot Low
   bool isPL = true;
   double plValue = iLow(_Symbol, PERIOD_CURRENT, pivotBar);
   
   for(int i = 1; i <= SwingLength; i++)
   {
      if(iLow(_Symbol, PERIOD_CURRENT, pivotBar - i) <= plValue ||
         iLow(_Symbol, PERIOD_CURRENT, pivotBar + i) <= plValue)
      {
         isPL = false;
         break;
      }
   }
   
   if(isPL && plValue != lastPivotLow)
   {
      lastPivotLow = plValue;
      Print("New Pivot Low detected at: ", lastPivotLow);
   }
   
   // Detect Sweep
   DetectSweep();
}

//+------------------------------------------------------------------+
void DetectSweep()
{
   sweepDetected = false;
   sweepType = "";
   
   if(lastPivotHigh == 0 || lastPivotLow == 0)
   {
      Print("No pivots detected yet. PH=", lastPivotHigh, " PL=", lastPivotLow);
      return;
   }
   
   double currentLow = iLow(_Symbol, PERIOD_CURRENT, 0);
   double currentHigh = iHigh(_Symbol, PERIOD_CURRENT, 0);
   double currentClose = iClose(_Symbol, PERIOD_CURRENT, 0);
   
   Print("Checking sweep... Current: H=", currentHigh, " L=", currentLow, " C=", currentClose);
   Print("Last Pivot High=", lastPivotHigh, " Last Pivot Low=", lastPivotLow);
   
   // Bullish Sweep: price goes below pivot low but closes above
   if(currentLow < lastPivotLow && currentClose > lastPivotLow)
   {
      sweepDetected = true;
      sweepType = "BULLISH";
      Print(">>> BULLISH SWEEP DETECTED <<<");
   }
   
   // Bearish Sweep: price goes above pivot high but closes below
   if(currentHigh > lastPivotHigh && currentClose < lastPivotHigh)
   {
      sweepDetected = true;
      sweepType = "BEARISH";
      Print(">>> BEARISH SWEEP DETECTED <<<");
   }
}

//+------------------------------------------------------------------+
void CheckEntrySetup()
{
   int totalBars = iBars(_Symbol, PERIOD_CURRENT);
   if(totalBars < 3) return;
   
   double fvgTop = 0, fvgBottom = 0;
   bool fvgFound = false;
   
   if(sweepType == "BULLISH")
   {
      double currentLow = iLow(_Symbol, PERIOD_CURRENT, 0);
      double twoBarsAgoHigh = iHigh(_Symbol, PERIOD_CURRENT, 2);
      
      if(currentLow > twoBarsAgoHigh)
      {
         fvgTop = currentLow;
         fvgBottom = twoBarsAgoHigh;
         double fvgSize = fvgTop - fvgBottom;
         
         if(fvgSize >= FVGThreshold)
         {
            fvgFound = true;
            Print("Bullish FVG found: ", fvgBottom, " to ", fvgTop, " Size=", fvgSize);
         }
      }
   }
   else if(sweepType == "BEARISH")
   {
      double currentHigh = iHigh(_Symbol, PERIOD_CURRENT, 0);
      double twoBarsAgoLow = iLow(_Symbol, PERIOD_CURRENT, 2);
      
      if(currentHigh < twoBarsAgoLow)
      {
         fvgTop = twoBarsAgoLow;
         fvgBottom = currentHigh;
         double fvgSize = fvgTop - fvgBottom;
         
         if(fvgSize >= FVGThreshold)
         {
            fvgFound = true;
            Print("Bearish FVG found: ", fvgBottom, " to ", fvgTop, " Size=", fvgSize);
         }
      }
   }
   
   if(!fvgFound)
   {
      Print("No FVG found. Trade skipped.");
      return;
   }
   
   // Check ChoCh
   bool choCh = false;
   if(sweepType == "BULLISH")
   {
      if(iClose(_Symbol, PERIOD_CURRENT, 0) > iHigh(_Symbol, PERIOD_CURRENT, 1))
      {
         choCh = true;
         Print("Bullish ChoCh confirmed");
      }
   }
   else
   {
      if(iClose(_Symbol, PERIOD_CURRENT, 0) < iLow(_Symbol, PERIOD_CURRENT, 1))
      {
         choCh = true;
         Print("Bearish ChoCh confirmed");
      }
   }
   
   if(choCh)
   {
      Print("All conditions met! Entering trade...");
      EnterTrade(sweepType, fvgTop, fvgBottom);
   }
   else
   {
      Print("No ChoCh. Trade skipped.");
   }
}

//+------------------------------------------------------------------+
void EnterTrade(string type, double fvgTop, double fvgBottom)
{
   MqlTradeRequest request = {};
   MqlTradeResult result = {};
   
   double price = (type == "BULLISH") ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double lotSize = CalculateLotSize(RiskPercent);
   
   double sl = 0, tp = 0;
   
   if(type == "BULLISH")
   {
      sl = price - StopLossPoints * _Point;
      tp = price + TakeProfitPoints * _Point;
      
      double risk = price - sl;
      double reward = tp - price;
      double rr = reward / risk;
      
      Print("BULLISH Trade: Entry=", price, " SL=", sl, " TP=", tp, " R:R=", rr);
      
      if(rr < MinRiskReward)
      {
         Print("R:R too low: ", rr, ". Trade skipped.");
         return;
      }
   }
   else
   {
      sl = price + StopLossPoints * _Point;
      tp = price - TakeProfitPoints * _Point;
      
      double risk = sl - price;
      double reward = price - tp;
      double rr = reward / risk;
      
      Print("BEARISH Trade: Entry=", price, " SL=", sl, " TP=", tp, " R:R=", rr);
      
      if(rr < MinRiskReward)
      {
         Print("R:R too low: ", rr, ". Trade skipped.");
         return;
      }
   }
   
   request.action = TRADE_ACTION_DEAL;
   request.symbol = _Symbol;
   request.volume = lotSize;
   request.type = (type == "BULLISH") ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
   request.price = price;
   request.sl = sl;
   request.tp = tp;
   request.deviation = 10;
   request.magic = 123456;
   request.comment = "Simple Golden Triangle";
   
   Print("Sending order...");
   
   if(OrderSend(request, result))
   {
      if(result.retcode == TRADE_RETCODE_DONE)
      {
         tradesToday++;
         Print(">>> TRADE OPENED SUCCESSFULLY <<<");
         Print("Type: ", type, " | Lots: ", lotSize, " | Entry: ", price);
         Print("SL: ", sl, " | TP: ", tp);
         Print("Trades today: ", tradesToday);
      }
      else
      {
         Print("Trade failed. Retcode: ", result.retcode);
         Print("Comment: ", result.comment);
      }
   }
   else
   {
      Print("OrderSend failed. Error: ", GetLastError());
   }
}

//+------------------------------------------------------------------+
double CalculateLotSize(double riskPercent)
{
   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   double riskAmount = balance * (riskPercent / 100.0);
   double tickValue = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   double tickSize = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   
   if(tickSize == 0) tickSize = _Point;
   
   double lotSize = riskAmount / (StopLossPoints * tickValue / tickSize);
   
   double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maxLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   
   if(lotStep == 0) lotStep = 0.01;
   
   lotSize = MathFloor(lotSize / lotStep) * lotStep;
   lotSize = MathMax(minLot, MathMin(maxLot, lotSize));
   
   Print("Calculated lot size: ", lotSize);
   
   return NormalizeDouble(lotSize, 2);
}

//+------------------------------------------------------------------+
void ManagePositions()
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != 123456) continue;
      
      if(UseBreakEven)
      {
         double openPrice = PositionGetDouble(POSITION_PRICE_OPEN);
         double curSL = PositionGetDouble(POSITION_SL);
         double curTP = PositionGetDouble(POSITION_TP);
         double price = SymbolInfoDouble(_Symbol, SYMBOL_BID);
         long posType = PositionGetInteger(POSITION_TYPE);
         
         if(posType == POSITION_TYPE_BUY)
         {
            if(price - openPrice >= BreakEvenTrigger * _Point && curSL < openPrice)
            {
               ModifyPosition(ticket, openPrice + BreakEvenProfit * _Point, curTP);
            }
         }
         else
         {
            if(openPrice - price >= BreakEvenTrigger * _Point && curSL > openPrice)
            {
               ModifyPosition(ticket, openPrice - BreakEvenProfit * _Point, curTP);
            }
         }
      }
   }
}

//+------------------------------------------------------------------+
void ModifyPosition(ulong ticket, double sl, double tp)
{
   MqlTradeRequest request = {};
   MqlTradeResult result = {};
   
   request.action = TRADE_ACTION_SLTP;
   request.position = ticket;
   request.sl = sl;
   request.tp = tp;
   
   if(!OrderSend(request, result))
      Print("Modify error: ", GetLastError());
   else
      Print("Position modified. SL=", sl, " TP=", tp);
}
